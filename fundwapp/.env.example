# ============================================================================
# Fundwapp configuration. Copy to .env and fill in. Nothing below is baked into
# the code: every value the app uses comes from here or from the database
# (settings / categories / payment_methods / payout_methods tables).
# ============================================================================

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL of this app (used in share links, QR codes, emails, card return URLs)
APP_BASE_URL=http://localhost:3000
# IANA timezone used to decide "today" for campaign start/end dates
APP_TIMEZONE=Africa/Nairobi
# Comma separated browser/mobile origins allowed to call the API (blank = same-origin only)
CORS_ORIGINS=
# Set true when running behind a reverse proxy / load balancer (Render, Fly, nginx...)
TRUST_PROXY=false
# Apply pending SQL migrations automatically on boot (handy for Docker)
AUTO_MIGRATE=false

# ---- Database: Turso (libSQL) or a local SQLite file -----------------------
# LOCAL SQLITE FILE (development):
DATABASE_URL=file:./data/fundwapp.db
DATABASE_AUTH_TOKEN=
# TURSO CLOUD (production) - replace the two lines above with:
#   DATABASE_URL=libsql://<your-db>-<your-org>.turso.io
#   DATABASE_AUTH_TOKEN=<token from: turso db tokens create <your-db>>
# OPTIONAL embedded replica (local file that syncs with Turso). Keep DATABASE_URL=file:...
# and also set the Turso URL here plus DATABASE_AUTH_TOKEN:
DATABASE_SYNC_URL=
DATABASE_SYNC_INTERVAL_SECONDS=60

# ---- Money -----------------------------------------------------------------
CURRENCY_CODE=KES
# Number of decimal places the currency uses (KES = 2). Amounts are stored as integers in minor units.
CURRENCY_MINOR_UNITS=2
LOCALE=en-KE
# Calling code (digits only) used to normalise phone numbers typed without a country code
DEFAULT_COUNTRY_CALLING_CODE=254

# ---- Authentication --------------------------------------------------------
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Development only: include the OTP in API responses so you can test without SMS. Ignored in production.
EXPOSE_DEV_OTP=true

# ---- Rate limits (requests per window) --------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_GLOBAL_MAX=600

# ---- Payments --------------------------------------------------------------
# sandbox = simulated gateway (approve/decline buttons appear on the payment screen)
# live    = real M-Pesa (Daraja) integration below
PAYMENT_MODE=sandbox
# Random string placed in gateway callback URLs so only gateways can call them
PAYMENT_CALLBACK_SECRET=
# Public HTTPS URL gateways can reach (use an ngrok/cloudflared URL in development). Blank = APP_BASE_URL
PAYMENT_CALLBACK_BASE_URL=

# M-Pesa Daraja (STK push for contributions, B2C for payouts). M-Pesa is the only supported gateway.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number / party B when different from shortcode (Buy Goods). Blank = MPESA_SHORTCODE
MPESA_PARTY_B=
MPESA_INITIATOR_NAME=
# Already-encrypted SecurityCredential for the initiator (see Daraja docs)
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_SHORTCODE=
MPESA_B2C_COMMAND_ID=BusinessPayment

# ---- Notifications ---------------------------------------------------------
# console = print messages to the server log (development) | twilio | vonage | africastalking
SMS_PROVIDER=console
AT_BASE_URL=https://api.sandbox.africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Twilio (recommended): Console dashboard shows the Account SID and Auth Token
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in +E.164 format, OR use a Messaging Service SID instead
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Vonage (alternative)
VONAGE_BASE_URL=https://rest.nexmo.com
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=
# console | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=Fundwapp <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_MAX_ATTEMPTS=3

# ---- File storage (cover photos) -------------------------------------------
# local = saved in UPLOAD_DIR and served from /uploads | s3 = any S3-compatible bucket
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket/CDN, e.g. https://cdn.example.com
S3_PUBLIC_BASE_URL=

# ---- Background jobs (cron syntax, evaluated in APP_TIMEZONE) --------------
JOBS_ENABLED=true
CRON_RECONCILIATION=*/5 * * * *
CRON_EXPIRE_CAMPAIGNS=0 * * * *
CRON_RETRY_NOTIFICATIONS=*/10 * * * *

# ---- Input limits ----------------------------------------------------------
TITLE_MAX_LENGTH=120
DESCRIPTION_MAX_LENGTH=8000
MESSAGE_MAX_LENGTH=280

# ---- Used only by `npm run admin:create` (or pass flags) ---------------------
ADMIN_FULL_NAME=
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
