# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fundwapp
DB_USER=postgres
DB_PASSWORD=changeme

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# M-Pesa (Safaricom Daraja API)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback
MPESA_ENV=sandbox

# Airtel Money
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_URL=https://your-domain.com/api/payments/airtel/callback

# Card gateway (e.g. Flutterwave/Stripe/Pesapal - placeholder)
CARD_GATEWAY_API_KEY=
CARD_GATEWAY_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@fundwapp.com

# SMS provider (e.g. Africa's Talking)
SMS_API_KEY=
SMS_USERNAME=

# Frontend URL (used to build public fundraiser links)
FRONTEND_URL=http://localhost:3000
